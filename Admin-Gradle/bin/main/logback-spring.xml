<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Appender for instance events -->
    <appender name="INSTANCE_EVENTS_FILE" class="ch.qos.logback.core.FileAppender">
        <file>admin-gradle/logs/instance-events.log</file>
        <append>true</append>
        <immediateFlush>true</immediateFlush>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Custom filter to capture only registration and deregistration events -->
    <appender name="FILTERED_INSTANCE_EVENTS" class="ch.qos.logback.core.filter.EvaluatorFilter">
        <evaluator class="ch.qos.logback.classic.boolex.OnMarkerEvaluator">
            <marker>REGISTRATION_EVENT</marker>
            <marker>DEREGISTRATION_EVENT</marker>
        </evaluator>
        <OnMismatch>DENY</OnMismatch>
        <OnMatch>ACCEPT</OnMatch>
    </appender>

     <!-- Log only events from InstanceEventLogger -->
    <logger name="com.example.admin_gradle.InstanceEventLogger" level="INFO" additivity="false">
        <appender-ref ref="INSTANCE_EVENTS_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Log specific instance events with filtering -->
    <logger name="de.codecentric.boot.admin.server.events" level="INFO" additivity="false">
        <appender-ref ref="INSTANCE_EVENTS_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Suppress noisy loggers -->
    <logger name="de.codecentric.boot.admin.server.web" level="ERROR"/>
    <logger name="de.codecentric.boot.admin.server.services" level="ERROR"/>
    <logger name="de.codecentric.boot.admin.server.events" level="ERROR"/>
    <logger name="org.springframework.web" level="ERROR"/>
    <logger name="org.springframework.web.reactive.function.client" level="ERROR"/>
    <logger name="reactor.netty" level="ERROR"/>
    <logger name="org.apache.catalina" level="ERROR"/>
    <logger name="org.apache.tomcat" level="ERROR"/>

    <!-- Root logger -->
    <root level="ERROR">
        <appender-ref ref="INSTANCE_EVENTS_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
